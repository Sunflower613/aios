  "lines": [
    {
      "time": 24.36,
      "text": "嘲笑谁恃美扬威",
      "playable": true,
      "melodyId": 0
    },
    {
      "time": 29.95,
      "text": "没了心如何相配",
      "playable": true,
      "melodyId": 1
    },
    {
      "time": 34.85,
      "text": "盘铃声清脆",
      "playable": true,
      "melodyId": 2
    },
    {
      "time": 37.71,
      "text": "帷幕间灯火幽微",
      "playable": true,
      "melodyId": 3
    },
    {
      "time": 40.5,
      "text": "我和你 最天生一对",
      "playable": true,
      "melodyId": 4
    },
    {
      "time": 46.64,
      "text": "没了你才算原罪",
      "playable": true,
      "melodyId": 5
    },
    {
      "time": 52.23,
      "text": "没了心才好相配",
      "playable": true,
      "melodyId": 6
    },
    {
      "time": 57.16,
      "text": "你褴褛我彩绘",
      "playable": true,
      "melodyId": 7
    },
    {
      "time": 60.03,
      "text": "并肩行过山与水",
      "playable": true,
      "melodyId": 8
    },
    {
      "time": 62.72,
      "text": "你憔悴 我替你明媚",
      "playable": true,
      "melodyId": 9
    },
    {
      "time": 68.23,
      "text": "是你吻开笔墨",
      "playable": true,
      "melodyId": 10
    },
    {
      "time": 71.16,
      "text": "染我眼角珠泪",
      "playable": true,
      "melodyId": 11
    },
    {
      "time": 74.03,
      "text": "演离合相遇悲喜为谁",
      "playable": true,
      "melodyId": 12
    },
    {
      "time": 79.56,
      "text": "他们迂回误会",
      "playable": true,
      "melodyId": 13
    },
    {
      "time": 82.37,
      "text": "我却只由你支配",
      "playable": true,
      "melodyId": 14
    },
    {
      "time": 85.11,
      "text": "问世间哪有更完美",
      "playable": true,
      "melodyId": 15
    },
    {
      "time": 90.41,
      "text": "兰花指捻红尘似水",
      "playable": true,
      "melodyId": 16
    },
    {
      "time": 95.74,
      "text": "三尺红台 万事入歌吹",
      "playable": true,
      "melodyId": 17
    },
    {
      "time": 101.4,
      "text": "唱别久悲不成悲",
      "playable": true,
      "melodyId": 18
    },
    {
      "time": 104.59,
      "text": "十分红处竟成灰",
      "playable": true,
      "melodyId": 19
    },
    {
      "time": 107.42,
      "text": "愿谁记得谁 最好的年岁",
      "playable": true,
      "melodyId": 20
    },
    {
      "time": 136.04,
      "text": "你一牵我舞如飞",
      "playable": true,
      "melodyId": 21
    },
    {
      "time": 141.49,
      "text": "你一引我懂进退",
      "playable": true,
      "melodyId": 22
    },
    {
      "time": 146.44,
      "text": "苦乐都跟随",
      "playable": true,
      "melodyId": 23
    },
    {
      "time": 149.19,
      "text": "举手投足不违背",
      "playable": true,
      "melodyId": 24
    },
    {
      "time": 152.11,
      "text": "将谦卑 温柔成绝对",
      "playable": true,
      "melodyId": 25
    },
    {
      "time": 157.62,
      "text": "你错我不肯对",
      "playable": true,
      "melodyId": 26
    },
    {
      "time": 160.41,
      "text": "你懵懂我蒙昧",
      "playable": true,
      "melodyId": 27
    },
    {
      "time": 163.21,
      "text": "心火怎甘心扬汤止沸",
      "playable": true,
      "melodyId": 28
    },
    {
      "time": 168.79,
      "text": "你枯我不曾萎",
      "playable": true,
      "melodyId": 29
    },
    {
      "time": 171.61,
      "text": "你倦我也不敢累",
      "playable": true,
      "melodyId": 30
    },
    {
      "time": 174.4,
      "text": "用什么暖你一千岁",
      "playable": true,
      "melodyId": 31
    },
    {
      "time": 179.61,
      "text": "风雪依稀秋白发尾",
      "playable": true,
      "melodyId": 32
    },
    {
      "time": 185.3,
      "text": "灯火葳蕤 揉皱你眼眉",
      "playable": true,
      "melodyId": 33
    },
    {
      "time": 190.81,
      "text": "假如你舍一滴泪",
      "playable": true,
      "melodyId": 34
    },
    {
      "time": 193.92,
      "text": "假如老去我能陪",
      "playable": true,
      "melodyId": 35
    },
    {
      "time": 196.5,
      "text": "烟波里成灰 也去得完美",
      "playable": true,
      "melodyId": 36
    },
    {
      "time": 203.14,
      "text": "风雪依稀秋白发尾",
      "playable": true,
      "melodyId": 32
    },
    {
      "time": 207.6,
      "text": "灯火葳蕤 揉皱你眼眉",
      "playable": true,
      "melodyId": 33
    },
    {
      "time": 213.15,
      "text": "假如你舍一滴泪",
      "playable": true,
      "melodyId": 34
    },
    {
      "time": 216.36,
      "text": "假如老去我能陪",
      "playable": true,
