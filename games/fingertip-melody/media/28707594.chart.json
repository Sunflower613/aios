  "lines": [
    {
      "time": 5.02,
      "text": "夜空中最亮的星 能否听清",
      "playable": true,
      "melodyId": 0
    },
    {
      "time": 13.75,
      "text": "那仰望的人 心底的孤独和叹息",
      "playable": true,
      "melodyId": 1
    },
    {
      "time": 21.66,
      "text": "oh夜空中最亮的星 能否记起",
      "playable": true,
      "melodyId": 2
    },
    {
      "time": 31.45,
      "text": "曾与我同行消失在风里的身影",
      "playable": true,
      "melodyId": 3
    },
    {
      "time": 39.29,
      "text": "我祈祷拥有一颗透明的心灵",
      "playable": true,
      "melodyId": 4
    },
    {
      "time": 44.5,
      "text": "和会流泪的眼睛",
      "playable": true,
      "melodyId": 5
    },
    {
      "time": 50.09,
      "text": "给我再去相信的勇气",
      "playable": true,
      "melodyId": 6
    },
    {
      "time": 53.22,
      "text": "越过谎言去拥抱你",
      "playable": true,
      "melodyId": 7
    },
    {
      "time": 57.35,
      "text": "每当我找不到存在的意义",
      "playable": true,
      "melodyId": 8
    },
    {
      "time": 62.03,
      "text": "每当我迷失在黑夜里",
      "playable": true,
      "melodyId": 9
    },
    {
      "time": 67.86,
      "text": "夜空中最亮的星",
      "playable": true,
      "melodyId": 10
    },
    {
      "time": 71.35,
      "text": "请指引我靠近你",
      "playable": true,
      "melodyId": 11
    },
    {
      "time": 80.48,
      "text": "夜空中最亮的星 是否知道",
      "playable": true,
      "melodyId": 12
    },
    {
      "time": 89.25,
      "text": "曾与我同行的身影 如今在哪里",
      "playable": true,
      "melodyId": 13
    },
    {
      "time": 98.41,
      "text": "夜空中最亮的星 是否在意",
      "playable": true,
      "melodyId": 14
    },
    {
      "time": 106.71,
      "text": "是等太阳升起 还是意外先来临",
      "playable": true,
      "melodyId": 15
    },
    {
      "time": 114.87,
      "text": "我宁愿所有痛苦都留在心里",
      "playable": true,
      "melodyId": 16
    },
    {
      "time": 119.94,
      "text": "也不愿忘记你的眼睛",
      "playable": true,
      "melodyId": 17
    },
    {
      "time": 125.72,
      "text": "给我再去相信的勇气",
      "playable": true,
      "melodyId": 6
    },
    {
      "time": 129.03,
      "text": "越过谎言去拥抱你",
      "playable": true,
      "melodyId": 7
    },
    {
      "time": 132.93,
      "text": "每当我找不到存在的意义",
      "playable": true,
      "melodyId": 8
    },
    {
      "time": 137.74,
      "text": "每当我迷失在黑夜里",
      "playable": true,
      "melodyId": 9
    },
    {
      "time": 143.47,
      "text": "夜空中最亮的星",
      "playable": true,
      "melodyId": 10
    },
    {
      "time": 146.96,
      "text": "请照亮我前行",
