; 21点（Blackjack）游戏后端 —— Go 静态编译 + WebSocket
; 由 aios 部署脚本安装；静态目录由可执行文件工作目录自动推导为
; /var/www/aios/games/21dian（站点实际由 Caddy 提供，本服务只负责 /api 与 /ws）
[Unit]
Description=21点 Blackjack 游戏服务器 (Go, HTTP + WebSocket)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/aios/games/21dian/backend/build
Environment=PORT=8081
ExecStart=/var/www/aios/games/21dian/backend/build/blackjack-linux-amd64
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
